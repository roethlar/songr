# Server host/interface to bind to.
# Default 0.0.0.0 makes the controller reachable on the LAN — appropriate
# for a single-purpose home appliance. Set HOST=127.0.0.1 to restrict to
# localhost (recommended when running behind a reverse proxy).
HOST=0.0.0.0

# HTTP port for the backend API and socket server.
# PORT=0 asks the OS for a free ephemeral port; a parent process that forked
# this backend learns the real port from the { type: "listening", port }
# IPC message sent once the server is bound. Leave it fixed for an appliance
# install, where nothing is listening for that message.
PORT=3333

# Base directories for everything the controller writes: CONFIG_DIR holds
# pairing state, DATA_DIR holds caches and persisted user data. Setting these
# relocates the whole footprint in one move; the per-file variables below
# still win where they are set. Defaults reproduce the layout shown here.
# CONFIG_DIR=./config
# DATA_DIR=./data

# Pino log level (fatal|error|warn|info|debug|trace|silent).
# Set to "trace" temporarily to capture raw Roon subscribe_zones and
# subscribe_queue payloads — useful for debugging queue ordering and
# current-track-row issues.
LOG_LEVEL=info

# Location of the Roon pairing token
ROON_TOKEN_PATH=./config/roon-token.json

# Directory for cached artwork from Roon (created automatically)
IMAGE_CACHE_PATH=./data/image-cache

# Maximum size of the on-disk image cache in bytes. When exceeded, the
# oldest entries (by mtime) are evicted down to ~90% of this cap.
# Default: 10 GB.
IMAGE_CACHE_MAX_BYTES=10737418240

# JSON file for "Recently played on this controller" persistence. The
# RecentlyPlayedService captures plays observed via Roon's
# now-playing-updated events while the service is running and writes
# them here (atomic write, mode 0o600).
# Default: ./data/recently-played.json
# RECENTLY_PLAYED_PATH=./data/recently-played.json

# Maximum number of entries kept in the rolling Recently Played list.
# Range 1-1000. Default: 50.
# RECENTLY_PLAYED_CAP=50

# JSON file for Songr Bookmarks (tracks / albums / artists), written
# atomically. Entries store display metadata; Songr resolves albums/artists
# against current public library rows or opens Search for a fresh selection.
# These are separate from Roon Favorites. The existing path/name is retained.
# Default: ./data/favorites.json
# FAVORITES_PATH=./data/favorites.json

# Comma-separated list of allowed origins for Socket.IO CORS, or "*" for any.
# Tighten this when fronting the controller with a reverse proxy or exposing
# beyond the LAN. Default: "*".
# CLIENT_ORIGIN=http://roon.lan,http://192.168.1.10:3333

# Set to "true" if running behind a reverse proxy so rate limits identify
# clients by their forwarded IP rather than the proxy IP.
# TRUST_PROXY=true

# ── Roon Browse health monitoring ──────────────────────────────────────
# ROON_BROWSE_CANARY: one root-level album browse every 30 s, with a 15 s
# timeout and at most one outstanding probe. Enabled by default. The probes
# log latency, detect an unresponsive Core, and supply health evidence to
# the pressure breaker and live-library read pacing. Setting this to 0 stops
# periodic probes and their health signals to these controls.
# Accepts 1/true/yes/on or 0/false/no/off; other values are rejected.
# ROON_BROWSE_CANARY=
#
# ROON_BROWSE_CANARY_BASELINE_P95_MS: the healthy-speed reference every rule
# built on it measures against. Each fires at 3× this number, so the shipped
# default of 500 draws one line at 1.5 s for a single root-level browse.
#
# The default is sized to catch a WEDGE — a Core that takes a request and
# never answers it, presenting as multi-second stalls and 15 s timeouts —
# not to police tens of milliseconds. A reference install answers this probe
# in about 20 ms, so 500 leaves roughly 24× headroom: a Core twenty times
# slower still reads as healthy, while a root browse over 1.5 s does not.
#
# MEASURE YOUR OWN IF YOU WANT MORE THAN WEDGE DETECTION. Catching a Core
# that has been merely degraded since startup — slow but still answering —
# is relative to that Core's own healthy speed, and no shipped number can
# know it. Watch the logged probe latencies on a quiet, healthy Core, take
# the p95, and set it here.
# ROON_BROWSE_CANARY_BASELINE_P95_MS=
