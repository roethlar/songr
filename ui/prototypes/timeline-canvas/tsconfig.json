{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"isolatedModules": true,
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"target": "ES2022",
		"types": ["vite/client", "vitest/globals"]
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.svelte",
		"svelte.config.js",
		"vite.config.ts",
		"vitest.config.ts"
	]
}
