{
	"name": "roon-controller-ui",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"prototype:timeline": "vite --config prototypes/timeline-canvas/vite.config.ts",
		"prototype:timeline:check": "svelte-check --tsconfig ./prototypes/timeline-canvas/tsconfig.json",
		"prototype:timeline:test": "vite build --config prototypes/timeline-canvas/vite.config.ts && vitest run --config prototypes/timeline-canvas/vitest.config.ts",
		"prototype:timeline:build": "vite build --config prototypes/timeline-canvas/vite.config.ts",
		"prototype:timeline:preview": "vite preview --config prototypes/timeline-canvas/vite.config.ts"
	},
	"devDependencies": {
		"@fontsource/fira-mono": "^5.2.7",
		"@neoconfetti/svelte": "^2.2.2",
		"@sveltejs/adapter-auto": "^6.1.0",
		"@sveltejs/kit": "^2.43.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.0",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.3.1",
		"@testing-library/user-event": "^14.6.1",
		"jsdom": "^29.1.1",
		"svelte": "^5.39.5",
		"svelte-check": "^4.3.2",
		"typescript": "^5.9.2",
		"vite": "^7.1.7",
		"vitest": "^4.1.5"
	},
	"dependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"socket.io-client": "^4.8.1"
	},
	"overrides": {
		"cookie": "^0.7.0"
	}
}
